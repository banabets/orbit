{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/pons-api/launches",
      "destination": "https://ponsfamily.com/api/launches"
    },
    {
      "source": "/pons-api/launches/:token",
      "destination": "https://ponsfamily.com/api/launches/:token"
    },
    {
      "source": "/pons-api/identities",
      "destination": "https://ponsfamily.com/api/identities"
    },
    {
      "source": "/pons-claimed",
      "destination": "https://balancesapi.ponsfamily.com/v1/escrow/claimed"
    },
    {
      "source": "/token/:curve",
      "destination": "/api/page?c=:curve"
    },
    {
      "source": "/((?!api/|pons-api/|pons-claimed|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(|index.html|sw.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/snapshot.js": {
      "maxDuration": 10
    },
    "api/rewards.js": {
      "maxDuration": 30
    },
    "api/price.js": {
      "maxDuration": 10
    },
    "api/avatars.js": {
      "maxDuration": 10
    },
    "api/push.js": {
      "maxDuration": 20
    },
    "api/graduated.js": {
      "maxDuration": 30
    },
    "api/page.js": {
      "maxDuration": 10
    }
  }
}
